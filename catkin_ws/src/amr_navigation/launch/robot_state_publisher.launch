<launch>

    <!-- Load the robot URDF into /robot_description -->
    <param
        name="robot_description"
        textfile="$(find amr_navigation)/urdf/XStackDesign.urdf"
    />

    <!-- Publish TF from the URDF -->
    <node
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen"
    />

</launch>