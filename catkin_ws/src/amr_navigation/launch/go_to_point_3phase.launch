<launch>
  <param name="/use_sim_time" value="true" />

  <!-- Clean, intuitive arguments for daily use (meters & degrees) -->
  <arg name="goal_x" default="2.0" />
  <arg name="goal_y" default="0.0" />
  <arg name="goal_yaw" default="0.0" />         <!-- In DEGREES: e.g. 0.0, 90.0, -90.0, 180.0 -->
  <arg name="pos_tolerance" default="0.05" />   <!-- 0.05 m = 5 cm precision -->
  <arg name="yaw_tolerance" default="3.0" />    <!-- In DEGREES: 3.0 deg precision -->
  <arg name="auto_lift" default="true" />
  <arg name="lift_height" default="0.25" />

  <node pkg="amr_navigation" type="go_to_point_3phase.py" name="go_to_point_3phase" output="screen">
    <param name="goal_x" value="$(arg goal_x)" />
    <param name="goal_y" value="$(arg goal_y)" />
    <param name="goal_yaw" value="$(arg goal_yaw)" />
    <param name="pos_tolerance" value="$(arg pos_tolerance)" />
    <param name="yaw_tolerance" value="$(arg yaw_tolerance)" />
    <param name="auto_lift" value="$(arg auto_lift)" />
    <param name="lift_height" value="$(arg lift_height)" />
  </node>
</launch>
