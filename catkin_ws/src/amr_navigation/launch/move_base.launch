<launch>
    <!-- Compatibility entry point; share the fully configured navigation launch. -->
    <arg name="robot_profile" default="xstack" />
    <arg name="cmd_vel_topic" default="/cmd_vel" />
    <arg name="odom_topic" default="/odom" />
    <arg name="laser_topic" default="/scan" />

    <group>
        <remap from="/cmd_vel" to="$(arg cmd_vel_topic)" />
        <remap from="/odom" to="$(arg odom_topic)" />
        <remap from="/scan" to="$(arg laser_topic)" />
        <include file="$(find amr_navigation)/launch/warehouse_navigation.launch">
            <arg name="robot_profile" value="$(arg robot_profile)" />
        </include>
    </group>
</launch>
