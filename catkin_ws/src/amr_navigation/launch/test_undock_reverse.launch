<launch>
<!--
  =============================================================================
  TEST UNDOCK REVERSE: STAGING STATION DOCK, DEPOSIT & EXTRACTION TEST
  =============================================================================
  Executes an isolated 6-phase test of approaching the 25cm staging station deck
  (default station_2), lowering the mast to deposit height, and performing forward undock:
    1. Pre-Dock Staging: Navigates chassis to station standoff pose (12.10, 0.0, yaw 180.0 deg)
    2. Mast Elevation  : Elevates mast to transit height (0.28m, clearing 0.25m station by 40mm)
    3. Straight Reverse: Reverses over 25cm station to stop pose (12.90, 0.0) with locked yaw
    4. Station Deposit : Lowers mast to deposit height (0.21m): pallet touches down, forks float free
    5. Forward Undock  : Extracts forks forward to standoff (12.10, 0.0) leaving pallet on station
    6. Mast Home       : Lowers mast to idle/home height (0.00m)

  ARGUMENTS:
    station             : Station to deliver to, named in locations_file (default: station_2)
    locations_file      : Named object centres + dock headings, exported from Unity (Tools > Export ROS Locations)
    station_dock_offset : drive_center stop in front of the station centre (default: 0.54m = pallet over the deck)
    standoff            : Pre-dock staging standoff distance (default: 0.8m -> stops at ~12.10m)
    transit_lift_height : Mast height during approach (default: 0.28m -> 40mm clearance)
    deposit_lift_height : Mast height for deposit (default: 0.21m -> forks float in pocket)
    dock_speed          : Docking reverse creep speed limit (default: 0.12 m/s)
    transit_speed       : Linear speed limit to station staging standoff (default: 0.45 m/s)
    lift_speed          : Mast elevation vertical speed limit (default: 0.08 m/s)

  COMMON USAGE EXAMPLES:
    # 1. Run isolated staging station undock test on station_2:
    roslaunch amr_navigation test_undock_reverse.launch

    # 2. Another station, standoff, and speeds:
    roslaunch amr_navigation test_undock_reverse.launch station:=station_1 standoff:=0.8 transit_speed:=0.50 dock_speed:=0.12 lift_speed:=0.08
  =============================================================================
-->
  <param name="/use_sim_time" value="true" />

  <!-- Named locations: object centres in map, exported from Unity (Tools > Export ROS Locations) -->
  <arg name="locations_file" default="$(find amr_navigation)/config/locations_milestone_3.yaml" />
  <arg name="station" default="station_2" />
  <!-- drive_center stops this far in front of the station centre when docked -->
  <arg name="station_dock_offset" default="0.54" />

  <!-- Standoff distance in front of dock stop pose (default: 0.8m -> stops at ~12.10m) -->
  <arg name="standoff" default="0.8" />

  <!-- Vertical Clearances (25cm Station Surface = 0.25m) -->
  <!-- Transit: 0.28m gives pallet bottom 0.29m (40mm clearance over 0.25m station) -->
  <!-- Deposit: 0.21m touches pallet down at 0.24m and sinks forks to 0.21m floating in cavity -->
  <arg name="transit_lift_height" default="0.28" />
  <arg name="deposit_lift_height" default="0.21" />

  <!-- Speed Parameters -->
  <arg name="dock_speed" default="0.12" />
  <arg name="transit_speed" default="0.45" />
  <arg name="lift_speed" default="0.08" />

  <!-- Pallet Station Undock Reverse Node -->
  <node pkg="amr_navigation" type="test_undock_reverse.py" name="test_undock_reverse" output="screen">
    <rosparam command="load" file="$(arg locations_file)" />
    <param name="station" value="$(arg station)" />
    <param name="station_dock_offset" value="$(arg station_dock_offset)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="transit_lift_height" value="$(arg transit_lift_height)" />
    <param name="deposit_lift_height" value="$(arg deposit_lift_height)" />
    <param name="dock_speed" value="$(arg dock_speed)" />
    <param name="transit_speed" value="$(arg transit_speed)" />
    <param name="lift_speed" value="$(arg lift_speed)" />
  </node>
</launch>
