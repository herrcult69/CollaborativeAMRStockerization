<launch>
  <!-- Navigation mount TF only. Do not run alongside display.launch / robot_state_publisher.
       Unity owns odom -> base frame. Nominal flat-floor mounts require runtime verification. -->
  <arg name="robot_profile" default="xstack" doc="xstack or legacy; must match the Unity scene" />
  <arg name="base_frame" value="$(eval {'xstack': 'drive_center', 'legacy': 'base_footprint'}[arg('robot_profile')])" />
  <arg name="publish_base_mount" default="true" />
  <arg name="publish_laser_mount" default="true" />
  <arg name="base_x" default="$(eval {'xstack': 0.10, 'legacy': 0.0}[arg('robot_profile')])" />
  <arg name="base_height" default="0.05" />
  <arg name="laser_x" default="$(eval {'xstack': 0.23, 'legacy': 0.25}[arg('robot_profile')])" />
  <arg name="laser_y" default="0.0" />
  <arg name="laser_z" default="$(eval {'xstack': 0.08, 'legacy': 0.225}[arg('robot_profile')])" />
  <node if="$(arg publish_base_mount)" pkg="tf2_ros" type="static_transform_publisher"
        name="lesson_base_mount_tf"
        args="$(arg base_x) 0 $(arg base_height) 0 0 0 1 $(arg base_frame) base_link" />
  <node if="$(arg publish_laser_mount)" pkg="tf2_ros" type="static_transform_publisher"
        name="lesson_laser_mount_tf"
        args="$(arg laser_x) $(arg laser_y) $(arg laser_z) 0 0 0 1 base_link laser_link" />
</launch>
