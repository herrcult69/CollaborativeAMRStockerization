<launch>
<!--
  =============================================================================
  MILESTONE 2: HYBRID AUTONOMOUS NAVIGATION & PRECISION DOCKING MISSION
  =============================================================================
  Combines move_base (global DWA planner) for obstacle-avoiding corridor navigation
  with specialized controllers for millimeter-precision staging, mast lift & docking:
    1. move_base   : Navigates from spawn to Rack Pre-Stage waypoint (approach m before stage)
    2. MoveToPoint : Finalizes straight alignment onto rack axis at stage pose
    3. Mast Lift   : Positions forks to entry height (-0.020m / +0.240m / +0.640m)
    4. dock_reverse: Reverses into pallet cavity (drive_center stops at 4.0, 4.78)
    5. Pallet Lift : Uniform 20mm lift (+0.010m / +0.290m / +0.685m)
    6. undock      : Pulls forward out of rack to pre-dock staging pose
    7. Transit Lift: Elevates mast to 0.28m (clears 0.25m staging station deck)
    8. move_base   : Navigates warehouse corridor highway to Station Pre-Stage pose
    9. MoveToPoint : Finalizes straight alignment facing 180.0 deg (West) at station standoff
   10. dock_reverse: Reverses over 25cm station to deposit stop pose (12.90, 0.0)
   11. Mast Lower  : Lowers mast to 0.21m (pallet touches down at 0.24m, forks float free)
   12. undock      : Extracts forks forward to standoff & homes mast to 0.0m

  PREREQUISITES:
    Ensure warehouse_autonav.launch (or localization + navigation) is running first!

  ARGUMENTS:
    package             : Pallet to pick, named in locations_file (default: package_5)
    station             : Station to deliver to, named in locations_file (default: station_2)
    locations_file      : Named object centres + dock headings, exported from Unity (Tools > Export ROS Locations)
    pallet_dock_offset  : drive_center stop in front of the pallet centre (default: 0.342m = 85-90% tine penetration)
    station_dock_offset : drive_center stop in front of the station centre (default: 0.54m = pallet over the deck)
    rack_standoff       : Pre-dock runway distance for rack entry (default: 1.2m)
    standoff            : Pre-dock standoff distance from station dock (default: 0.8m)
    approach            : Handover margin from move_base goal to stage pose (default: 0.6m)
    move_base_timeout   : Timeout in seconds for move_base action goals (default: 180.0s)
    skip_pickup         : Set true if robot already carries a pallet (starts directly at transit)
    reset_inventory     : Clear the empty-slot list (/warehouse_inventory/empty); use after restarting Unity Play
    transit_speed       : Max cruising linear velocity (default: 0.45 m/s)
    dock_speed          : Max creep docking velocity (default: 0.12 m/s)
    lift_speed          : Mast elevation velocity (default: 0.08 m/s)

  COMMON USAGE EXAMPLES:
    # 1. Standard Milestone 2 pick-and-deliver mission:
    roslaunch amr_navigation milestone2.launch

    # 2. Pick a top-tier pallet (lift heights follow its exported height):
    roslaunch amr_navigation milestone2.launch package:=package_4

    # 3. Old box-face detection (lidar at load-box height):
    roslaunch amr_navigation milestone2.launch detect_mode:=load_face

    # 4. Pick another floor pallet (e.g. south rack, facing 90 deg) and deliver to another station:
    roslaunch amr_navigation milestone2.launch package:=package_101 station:=station_1

    # 5. Skip pickup (start with pallet loaded, deliver to station):
    roslaunch amr_navigation milestone2.launch skip_pickup:=true
  =============================================================================
-->
  <param name="/use_sim_time" value="true" />

  <arg name="skip_pickup" default="false" />
  <!-- Picking a lower pallet takes everything stacked on it; picked slots are remembered until reset -->
  <arg name="reset_inventory" default="false" />

  <!-- Named locations: object centres in map, exported from Unity (Tools > Export ROS Locations) -->
  <arg name="locations_file" default="$(find amr_navigation)/config/locations_milestone_3.yaml" />
  <arg name="package" default="package_5" />
  <arg name="station" default="station_2" />
  <!-- drive_center stops this far in front of the object centre when docked -->
  <arg name="pallet_dock_offset" default="0.342" />
  <arg name="station_dock_offset" default="0.54" />

  <arg name="rack_standoff" default="1.2" />

  <arg name="standoff" default="0.8" />

  <!-- move_base goal sits this far beyond the stage, nose toward it -->
  <arg name="approach" default="0.6" />
  <!-- Measure the pallet load face with the laser at the rack stage; abort if not confirmed -->
  <arg name="detect_pallet" default="true" />
  <!-- rack_legs (Variant: lidar under the bottom plank) or load_face (lidar at load-box height) -->
  <arg name="detect_mode" default="rack_legs" />
  <arg name="move_base_timeout" default="180.0" />

  <arg name="transit_lift_height" default="0.28" />
  <arg name="deposit_lift_height" default="0.21" />

  <arg name="dock_speed" default="0.12" />
  <arg name="transit_speed" default="0.45" />
  <arg name="lift_speed" default="0.08" />

  <node pkg="amr_navigation" type="milestone2_mission.py" name="milestone2_mission" output="screen">
    <param name="skip_pickup" value="$(arg skip_pickup)" />
    <param name="reset_inventory" value="$(arg reset_inventory)" />
    <rosparam command="load" file="$(arg locations_file)" />
    <param name="package" value="$(arg package)" />
    <param name="station" value="$(arg station)" />
    <param name="pallet_dock_offset" value="$(arg pallet_dock_offset)" />
    <param name="station_dock_offset" value="$(arg station_dock_offset)" />
    <param name="rack_standoff" value="$(arg rack_standoff)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="approach" value="$(arg approach)" />
    <param name="detect_pallet" value="$(arg detect_pallet)" />
    <param name="detect_mode" value="$(arg detect_mode)" />
    <param name="move_base_timeout" value="$(arg move_base_timeout)" />
    <param name="transit_lift_height" value="$(arg transit_lift_height)" />
    <param name="deposit_lift_height" value="$(arg deposit_lift_height)" />
    <param name="dock_speed" value="$(arg dock_speed)" />
    <param name="transit_speed" value="$(arg transit_speed)" />
    <param name="lift_speed" value="$(arg lift_speed)" />
  </node>
</launch>
