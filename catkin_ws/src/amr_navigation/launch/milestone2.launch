<launch>
  <!-- Milestone 2: move_base drives the long legs, precision controllers do staging and docking.
       Prerequisites: unity_bridge, laser_tf, warehouse_localization, warehouse_navigation. -->
  <param name="/use_sim_time" value="true" />

  <arg name="skip_pickup" default="false" />

  <arg name="pallet_x" default="4.0" />
  <arg name="pallet_y" default="5.0" />
  <arg name="dock_yaw" default="270.0" />
  <arg name="fork_offset" default="0.22" />

  <arg name="station_x" default="13.12" />
  <arg name="station_y" default="0.0" />
  <arg name="station_yaw" default="180.0" />
  <arg name="standoff" default="0.8" />

  <!-- move_base goal sits this far beyond the stage, nose toward it -->
  <arg name="approach" default="0.6" />
  <arg name="move_base_timeout" default="180.0" />

  <arg name="transit_lift_height" default="0.28" />
  <arg name="deposit_lift_height" default="0.21" />
  <arg name="pick_level" default="bottom" />

  <arg name="dock_speed" default="0.12" />
  <arg name="transit_speed" default="0.45" />
  <arg name="lift_speed" default="0.08" />

  <node pkg="amr_navigation" type="milestone2_mission.py" name="milestone2_mission" output="screen">
    <param name="skip_pickup" value="$(arg skip_pickup)" />
    <param name="pick_level" value="$(arg pick_level)" />
    <param name="pallet_x" value="$(arg pallet_x)" />
    <param name="pallet_y" value="$(arg pallet_y)" />
    <param name="dock_yaw" value="$(arg dock_yaw)" />
    <param name="fork_offset" value="$(arg fork_offset)" />
    <param name="station_x" value="$(arg station_x)" />
    <param name="station_y" value="$(arg station_y)" />
    <param name="station_yaw" value="$(arg station_yaw)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="approach" value="$(arg approach)" />
    <param name="move_base_timeout" value="$(arg move_base_timeout)" />
    <param name="transit_lift_height" value="$(arg transit_lift_height)" />
    <param name="deposit_lift_height" value="$(arg deposit_lift_height)" />
    <param name="dock_speed" value="$(arg dock_speed)" />
    <param name="transit_speed" value="$(arg transit_speed)" />
    <param name="lift_speed" value="$(arg lift_speed)" />
  </node>
</launch>
