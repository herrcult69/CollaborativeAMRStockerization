<launch>
<!--
  =============================================================================
  TEST DOCK REVERSE: PALLET RACK REVERSE DOCKING & EXTRACTION TEST
  =============================================================================
  Executes an isolated 5-phase test of reverse docking into a pallet rack,
  lifting the pallet, and extracting it forward out into the open aisle:
    1. Pre-Dock Staging: Navigates chassis to standoff pose (default: 1.2m from dock)
    2. Mast Entry Pose : Positions mast to entry height (-0.020m / +0.240m / +0.640m)
    3. Straight Reverse: Backs straight into pallet pocket with active heading lock
    4. Pallet Pick Lift: Elevates mast by uniform +20mm (+0.010m / +0.290m / +0.685m)
    5. Rack Extraction : Pulls forward out of rack to standoff, sets transit height (0.150m)

  ARGUMENTS:
    package             : Pallet to pick, named in locations_file (default: package_5)
    locations_file      : Named object centres + dock headings, exported from Unity (Tools > Export ROS Locations)
    dock_speed          : Reverse creep speed limit (default: 0.12 m/s; clamp >= 0.07 m/s prevents stiction)
    pallet_dock_offset  : drive_center stop in front of the pallet centre (default: 0.342m = 85-90% tine penetration)
    standoff            : Pre-dock staging runway distance (default: 1.2m)
    transit_speed       : Max forward navigation speed to staging point (default: 0.45 m/s)
    lift_speed          : Mast elevation vertical speed (default: 0.08 m/s)
    pick_level          : "bottom" / "1" (floor stack), "top" / "2" (upper stack), "shelf" / "3" (tier 2)

  COMMON USAGE EXAMPLES:
    # 1. Run default rack docking test on package_5 (bottom level):
    roslaunch amr_navigation test_dock_reverse.launch

    # 2. Pick upper pallet (second height) of a double stack:
    roslaunch amr_navigation test_dock_reverse.launch pick_level:=top

    # 3. Pick pallet from elevated second-tier rack shelf:
    roslaunch amr_navigation test_dock_reverse.launch pick_level:=shelf

    # 4. Pick from the opposite-side south rack (facing 90 deg):
    roslaunch amr_navigation test_dock_reverse.launch package:=package_101

    # 5. Another pallet, penetration depth, and creep speed:
    roslaunch amr_navigation test_dock_reverse.launch package:=package_21 pallet_dock_offset:=0.342 dock_speed:=0.12
  =============================================================================
-->
  <param name="/use_sim_time" value="true" />

  <!-- Named locations: object centres in map, exported from Unity (Tools > Export ROS Locations) -->
  <arg name="locations_file" default="$(find amr_navigation)/config/locations_milestone_3.yaml" />
  <arg name="package" default="package_5" />
  <!-- drive_center stops this far in front of the pallet centre when docked -->
  <arg name="pallet_dock_offset" default="0.342" />

  <!-- Staging Parameters -->
  <arg name="dock_speed" default="0.12" />
  <arg name="standoff" default="1.2" />

  <!-- Kinematic Speeds -->
  <arg name="transit_speed" default="0.45" />
  <arg name="lift_speed" default="0.08" />

  <!-- Pickup Level Profile: "bottom" (level 1), "top" (level 2, upper pallet), "shelf" (level 3) -->
  <arg name="pick_level" default="bottom" />

  <!-- Test Pallet Staging & Reverse Insertion -->
  <node pkg="amr_navigation" type="test_dock_reverse.py" name="test_dock_reverse" output="screen">
    <rosparam command="load" file="$(arg locations_file)" />
    <param name="package" value="$(arg package)" />
    <param name="pallet_dock_offset" value="$(arg pallet_dock_offset)" />
    <param name="dock_speed" value="$(arg dock_speed)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="transit_speed" value="$(arg transit_speed)" />
    <param name="lift_speed" value="$(arg lift_speed)" />
    <param name="pick_level" value="$(arg pick_level)" />
  </node>
</launch>
