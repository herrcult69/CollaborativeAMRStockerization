<launch>
<!--
  =============================================================================
  MILESTONE 1: END-TO-END AUTONOMOUS PALLET REPLENISHMENT MISSION
  =============================================================================
  Coordinates full pick-and-deliver cycle using precision controllers:
    1. Rack Approach   : Navigates to rack pre-dock staging pose (default: 4.0, 3.58, yaw 270 deg)
    2. Mast Positioning: Pre-positions mast to entry height (-0.020m / +0.240m / +0.640m)
    3. Rack Docking    : Straight reverse into pallet cavity (drive_center stops at 4.0, 4.78)
    4. Pallet Lift     : Uniform 20mm lift (+0.010m / +0.290m / +0.685m) preserving beam headroom
    5. Rack Extraction : Forward straight undock back to pre-dock staging pose (4.0, 3.58)
    6. Transit Lift    : Raises mast to 0.28m (clears 0.25m station deck by 40mm)
    7. Manhattan Nav   : Orthogonal transit via corridor junction (4.0, 0.0) -> avoid diagonal blockage
    8. Station Staging : Arrives at station standoff pose (12.10, 0.0) facing 180 deg (West)
    9. Station Docking : Reverses over 25cm station to deposit stop pose (12.90, 0.0)
   10. Station Deposit : Lowers mast to 0.21m (pallet touches down at 0.24m, forks float free)
   11. Forward Undock  : Extracts forks forward to standoff (12.10, 0.0) & homes mast to 0.0m

  ARGUMENTS:
    pick_level          : "bottom" / "1" (floor stack), "top" / "2" (upper stack), "shelf" / "3" (tier 2)
    package             : Pallet to pick, named in locations_file (default: package_5)
    station             : Station to deliver to, named in locations_file (default: station_2)
    locations_file      : Named object centres + dock headings, exported from Unity (Tools > Export ROS Locations)
    pallet_dock_offset  : drive_center stop in front of the pallet centre (default: 0.342m = 85-90% tine penetration)
    station_dock_offset : drive_center stop in front of the station centre (default: 0.54m = pallet over the deck)
    rack_standoff       : Pre-dock runway distance for rack entry (default: 1.2m)
    corridor_x, y       : Orthogonal highway junction waypoint (default: 4.0, 0.0)
    standoff            : Pre-dock standoff distance from station dock (default: 0.8m)
    skip_pickup         : Set true if robot is already carrying a pallet (starts directly at transit)
    transit_speed       : Max cruising linear velocity (default: 0.45 m/s)
    dock_speed          : Max creep docking velocity (default: 0.12 m/s)
    lift_speed          : Mast elevation velocity (default: 0.08 m/s)

  COMMON USAGE EXAMPLES:
    # 1. Standard bottom-level pallet replenishment:
    roslaunch amr_navigation milestone1.launch

    # 2. Pick upper pallet of double-stack:
    roslaunch amr_navigation milestone1.launch pick_level:=top

    # 3. Pick from second-tier elevated rack shelf:
    roslaunch amr_navigation milestone1.launch pick_level:=shelf

    # 4. Pick another floor pallet (e.g. south rack, facing 90 deg) and deliver to another station:
    roslaunch amr_navigation milestone1.launch package:=package_101 station:=station_1

    # 5. Skip pickup if robot already carries pallet:
    roslaunch amr_navigation milestone1.launch skip_pickup:=true

    # 6. High-speed demo run:
    roslaunch amr_navigation milestone1.launch transit_speed:=0.75 dock_speed:=0.15 lift_speed:=0.10
  =============================================================================
-->
  <param name="/use_sim_time" value="true" />

  <!-- Mission Execution Mode: set true to skip rack pickup if AMR already carries pallet -->
  <arg name="skip_pickup" default="false" />

  <!-- Named locations: object centres in map, exported from Unity (Tools > Export ROS Locations) -->
  <arg name="locations_file" default="$(find amr_navigation)/config/locations_milestone_3.yaml" />
  <arg name="package" default="package_5" />
  <arg name="station" default="station_2" />
  <!-- drive_center stops this far in front of the object centre when docked -->
  <arg name="pallet_dock_offset" default="0.342" />
  <arg name="station_dock_offset" default="0.54" />

  <!-- Rack Pickup Parameters -->
  <arg name="rack_standoff" default="1.2" />

  <!-- Orthogonal Corridor Transit Waypoints (Avoids Diagonal Blockage) -->
  <arg name="corridor_x" default="4.0" />
  <arg name="corridor_y" default="0.0" />

  <!-- Standoff distance in front of dock stop pose (default: 0.8m -> stops at ~12.10m) -->
  <arg name="standoff" default="0.8" />
  <arg name="station_standoff" default="$(arg standoff)" />

  <!-- Vertical Clearances (25cm Station Surface = 0.25m) -->
  <!-- Transit: 0.28m gives pallet bottom 0.29m (40mm clearance over 0.25m station) -->
  <!-- Deposit: 0.21m touches pallet down at 0.24m and sinks forks to 0.21m floating in cavity -->
  <arg name="transit_lift_height" default="0.28" />
  <arg name="deposit_lift_height" default="0.21" />

  <!-- Pickup Level Profile: "bottom" (level 1), "top" (level 2, upper pallet), "shelf" (level 3) -->
  <arg name="pick_level" default="bottom" />

  <!-- Speed Parameters -->
  <arg name="dock_speed" default="0.12" />
  <arg name="transit_speed" default="0.45" />
  <arg name="lift_speed" default="0.08" />

  <!-- Milestone 1 Autonomous Pallet Replenishment Mission -->
  <node pkg="amr_navigation" type="milestone1_mission.py" name="milestone1_mission" output="screen">
    <param name="skip_pickup" value="$(arg skip_pickup)" />
    <param name="pick_level" value="$(arg pick_level)" />
    <rosparam command="load" file="$(arg locations_file)" />
    <param name="package" value="$(arg package)" />
    <param name="station" value="$(arg station)" />
    <param name="pallet_dock_offset" value="$(arg pallet_dock_offset)" />
    <param name="station_dock_offset" value="$(arg station_dock_offset)" />
    <param name="rack_standoff" value="$(arg rack_standoff)" />
    <param name="corridor_x" value="$(arg corridor_x)" />
    <param name="corridor_y" value="$(arg corridor_y)" />
    <param name="standoff" value="$(arg standoff)" />
    <param name="station_standoff" value="$(arg station_standoff)" />
    <param name="transit_lift_height" value="$(arg transit_lift_height)" />
    <param name="deposit_lift_height" value="$(arg deposit_lift_height)" />
    <param name="dock_speed" value="$(arg dock_speed)" />
    <param name="transit_speed" value="$(arg transit_speed)" />
    <param name="lift_speed" value="$(arg lift_speed)" />
  </node>
</launch>
