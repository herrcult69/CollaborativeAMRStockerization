<?xml version="1.0"?>
<robot name="reverse_stacker_amr">

  <!-- Materials -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.45 0.0 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="yellow"><color rgba="0.95 0.8 0.0 1.0"/></material>

  <!-- base_footprint (Ground projection) -->
  <link name="base_footprint"/>

  <!-- base_link (Main Chassis - Dragger Front) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.15"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <inertia ixx="0.45" ixy="0.0" ixz="0.0" iyy="0.95" iyz="0.0" izz="1.30"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Left Drive Wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <!-- Positioned centrally for zero-point turning -->
    <origin xyz="0 0.22 0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Drive Wheel -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.22 0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Passive Caster -->
  <link name="front_caster_link">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.25 0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Rear Passive Caster -->
  <link name="rear_caster_link">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.25 0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Navigation LiDAR (Front-mounted for clear FOV) -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- Placed at the front (+X) of the chassis -->
    <origin xyz="0.25 0 0.225" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- REVERSE STACKER MECHANISM (Rear-mounted)       -->
  <!-- ============================================== -->

  <!-- Vertical Mast Frame -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry><box size="0.05 0.30 0.50"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry><box size="0.05 0.30 0.50"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <inertia ixx="0.28" ixy="0" ixz="0" iyy="0.21" iyz="0" izz="0.07"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <!-- Positioned at the extreme rear (-X) -->
    <origin xyz="-0.30 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- Fork Carriage (Slides vertically along mast) -->
  <link name="fork_carriage_link">
    <visual>
      <origin xyz="-0.025 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.35 0.05"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.025 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.35 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="fork_carriage_link"/>
    <origin xyz="-0.025 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Lifts from 0m to 0.40m high -->
    <limit lower="0.0" upper="0.40" effort="1000.0" velocity="0.1"/>
  </joint>

  <!-- Left Fork Tine (Extends backward in -X direction) -->
  <link name="left_fork_link">
    <visual>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.05 0.02"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.05 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_fork_joint" type="fixed">
    <parent link="fork_carriage_link"/>
    <child link="left_fork_link"/>
    <origin xyz="-0.025 0.12 0" rpy="0 0 0"/>
  </joint>

  <!-- Right Fork Tine (Extends backward in -X direction) -->
  <link name="right_fork_link">
    <visual>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.05 0.02"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.05 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_fork_joint" type="fixed">
    <parent link="fork_carriage_link"/>
    <child link="right_fork_link"/>
    <origin xyz="-0.025 -0.12 0" rpy="0 0 0"/>
  </joint>

</robot>
