<launch>
  <!-- Standalone description inspection; stop laser_tf.launch before using this. -->
  <arg name="robot_profile" default="xstack" doc="xstack or legacy; must match the Unity scene" />

  <!-- Load the URDF into the ROS Parameter Server -->
  <param name="robot_description" textfile="$(eval find('amr_description') + '/urdf/' + {'xstack': 'xstack_amr', 'legacy': 'stacker_amr'}[arg('robot_profile')] + '.urdf')" />

  <!-- Joint state publisher GUI to interactively test wheel & lift joints -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />

  <!-- Robot state publisher to broadcast tf frames -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- RViz for visualization -->
  <node name="rviz" pkg="rviz" type="rviz" required="false" />
</launch>
